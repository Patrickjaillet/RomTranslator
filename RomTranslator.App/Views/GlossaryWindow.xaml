<ui:FluentWindow x:Class="RomTranslator.App.Views.GlossaryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:RomTranslator.Core.Localization;assembly=RomTranslator.Core"
                 Title="{x:Static loc:Strings.Glossary_Title}"
                 Width="720"
                 Height="560"
                 MinWidth="560"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 FocusManager.FocusedElement="{Binding ElementName=NewTermTextBox}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{x:Static loc:Strings.Glossary_Title}" ShowMaximize="False" />

    <Grid Grid.Row="1" Margin="24,12,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ui:TextBox x:Name="NewTermTextBox"
                  Grid.Column="0"
                  MaxWidth="320"
                  HorizontalAlignment="Left"
                  PlaceholderText="{x:Static loc:Strings.Glossary_NewTermWatermark}" />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button Margin="8,0,8,0" Click="OnAddClick" Content="{x:Static loc:Strings.Glossary_AddButton}" IsDefault="True" />
        <ui:Button Command="{Binding RemoveEntryCommand}" Content="{x:Static loc:Strings.Glossary_RemoveButton}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="24,0,24,12">
      <Border Padding="1"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Visibility="{Binding Entries.Count, Converter={StaticResource CountToVisibility}}">
        <DataGrid AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="200"
                                 Binding="{Binding SourceTerm, Mode=OneWay}"
                                 Header="{x:Static loc:Strings.Glossary_SourceTermLabel}"
                                 IsReadOnly="True" />
            <DataGridTextColumn Width="200"
                                 Binding="{Binding TargetTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Header="{x:Static loc:Strings.Glossary_TargetTermLabel}" />
            <DataGridTextColumn Width="*"
                                 Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 Header="{x:Static loc:Strings.Glossary_NoteLabel}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <TextBlock HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Style="{DynamicResource Text.Secondary}"
                 Text="{x:Static loc:Strings.Glossary_NoEntries}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="{Binding Entries.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
    </Grid>

    <StackPanel Grid.Row="3"
                Margin="24,0,24,12"
                Visibility="{Binding HasInconsistencies, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{DynamicResource Text.Subheading}" Text="{x:Static loc:Strings.Glossary_InconsistenciesHeader}" />
      <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Inconsistencies}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="0,2" FontSize="13" Foreground="{DynamicResource Palette.WarningBrush}" TextWrapping="Wrap">
              <TextBlock.Text>
                <MultiBinding StringFormat="{x:Static loc:Strings.Glossary_InconsistencyMessage}">
                  <Binding Path="Entry.TranslatedText" />
                  <Binding Path="GlossaryEntry.TargetTerm" />
                  <Binding Path="GlossaryEntry.SourceTerm" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Grid.Row="4"
                Margin="{DynamicResource Metrics.PagePadding}"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <ui:Button Click="OnCloseClick" Content="{x:Static loc:Strings.Glossary_CloseButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
