<ui:FluentWindow x:Class="RomTranslator.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:RomTranslator.App.Controls"
                 xmlns:loc="clr-namespace:RomTranslator.Core.Localization;assembly=RomTranslator.Core"
                 Title="{x:Static loc:Strings.Settings_Title}"
                 Width="560"
                 Height="600"
                 MinWidth="480"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{x:Static loc:Strings.Settings_Title}" ShowMaximize="False" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="{DynamicResource Metrics.PagePadding}">

        <TextBlock Style="{DynamicResource Text.Subheading}" Text="{x:Static loc:Strings.Settings_LanguageSection}" />
        <Border Margin="0,8,0,0" Style="{DynamicResource Surface.Card}">
          <StackPanel>
            <TextBlock Style="{DynamicResource Text.Body}" Text="{x:Static loc:Strings.Settings_LanguageLabel}" />
            <ComboBox Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      MinWidth="240"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{x:Static loc:Strings.Settings_LanguageRestartNotice}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock Margin="0,24,0,0" Style="{DynamicResource Text.Subheading}" Text="{x:Static loc:Strings.Settings_ThemeSection}" />
        <Border Margin="0,8,0,0" Style="{DynamicResource Surface.Card}">
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Margin="0,0,10,0" VerticalAlignment="Center" Data="{StaticResource Icon.check}" IconSize="18" />
            <TextBlock VerticalAlignment="Center"
                       Style="{DynamicResource Text.Body}"
                       Text="{x:Static loc:Strings.Settings_ThemeLightOnly}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock Margin="0,24,0,0" Style="{DynamicResource Text.Subheading}" Text="{x:Static loc:Strings.Settings_FoldersSection}" />
        <Border Margin="0,8,0,0" Style="{DynamicResource Surface.Card}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{DynamicResource Text.Body}" Text="{x:Static loc:Strings.Settings_ConfigFolderLabel}" />
                <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding ConfigDirectory}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ui:Button Grid.Column="1"
                         VerticalAlignment="Center"
                         Command="{Binding OpenConfigFolderCommand}"
                         Content="{x:Static loc:Strings.Settings_OpenFolder}" />
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{DynamicResource Text.Body}" Text="{x:Static loc:Strings.Settings_ProjectsFolderLabel}" />
                <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding ProjectsDirectory}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ui:Button Grid.Column="1"
                         VerticalAlignment="Center"
                         Command="{Binding OpenProjectsFolderCommand}"
                         Content="{x:Static loc:Strings.Settings_OpenFolder}" />
            </Grid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{DynamicResource Text.Body}" Text="{x:Static loc:Strings.Settings_LogsFolderLabel}" />
                <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding LogsDirectory}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <ui:Button Grid.Column="1"
                         VerticalAlignment="Center"
                         Command="{Binding OpenLogsFolderCommand}"
                         Content="{x:Static loc:Strings.Settings_OpenFolder}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2"
                Margin="{DynamicResource Metrics.PagePadding}"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <ui:Button Margin="0,0,8,0" Click="OnCancelClick" Content="{x:Static loc:Strings.Settings_Cancel}" />
      <ui:Button Appearance="Primary" Click="OnSaveClick" Content="{x:Static loc:Strings.Settings_Save}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
