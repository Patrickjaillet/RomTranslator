<ui:FluentWindow x:Class="RomTranslator.App.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:RomTranslator.App.Controls"
                 xmlns:loc="clr-namespace:RomTranslator.Core.Localization;assembly=RomTranslator.Core"
                 Title="{x:Static loc:Strings.About_Title}"
                 Width="420"
                 Height="360"
                 MinWidth="420"
                 MinHeight="360"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{x:Static loc:Strings.About_Title}" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="32,8,32,24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <controls:SvgIcon HorizontalAlignment="Center" Data="{StaticResource Icon.gamepad}" IconSize="48" Foreground="{DynamicResource Palette.AccentBrush}" />

      <TextBlock Margin="0,16,0,0"
                 HorizontalAlignment="Center"
                 Style="{DynamicResource Text.Heading}"
                 Text="{Binding ProductName}" />
      <TextBlock Margin="0,4,0,0"
                 HorizontalAlignment="Center"
                 Style="{DynamicResource Text.Secondary}"
                 Text="{Binding VersionText}" />

      <TextBlock Margin="0,20,0,0"
                 HorizontalAlignment="Center"
                 Style="{DynamicResource Text.Secondary}"
                 Text="{Binding CopyrightText}" />
      <TextBlock Margin="0,4,0,0"
                 HorizontalAlignment="Center"
                 Style="{DynamicResource Text.Secondary}"
                 Text="{Binding LicenseText}"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />

      <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0"
                   AutomationProperties.Name="{Binding Website.Header}"
                   Command="{Binding Website.Command}"
                   Content="{Binding Website.Header}" />
        <ui:Button AutomationProperties.Name="{Binding Repository.Header}"
                   Command="{Binding Repository.Command}"
                   Content="{Binding Repository.Header}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
