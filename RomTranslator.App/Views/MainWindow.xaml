<ui:FluentWindow x:Class="RomTranslator.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:RomTranslator.App.Controls"
                 xmlns:vm="clr-namespace:RomTranslator.App.ViewModels"
                 xmlns:views="clr-namespace:RomTranslator.App.Views"
                 xmlns:loc="clr-namespace:RomTranslator.Core.Localization;assembly=RomTranslator.Core"
                 Title="RomTranslator"
                 Width="1280"
                 Height="720"
                 MinWidth="960"
                 MinHeight="540"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.InputBindings>
    <KeyBinding Command="{Binding NewProject.Command}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding OpenProject.Command}" Gesture="Ctrl+O" />
    <KeyBinding Command="{Binding SaveProject.Command}" Gesture="Ctrl+S" />
    <KeyBinding Command="{Binding ExportProject.Command}" Gesture="Ctrl+E" />
  </ui:FluentWindow.InputBindings>

  <ui:FluentWindow.Resources>
    <!-- Choix de la vue d'un onglet selon le type de son modèle de vue. -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>

    <DataTemplate x:Key="CommandBarButtonTemplate">
      <controls:SvgButton Margin="0,0,4,0"
                          Command="{Binding Command}"
                          IconData="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                          ToolTip="{Binding ToolTip}" />
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalItemsPanel">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Barre de titre personnalisée -->
    <ui:TitleBar Grid.Row="0" Title="{Binding Title}" />

    <!-- Menu principal -->
    <Menu Grid.Row="1" Margin="8,0,8,0" Background="Transparent">
        <MenuItem Header="{x:Static loc:Strings.Menu_File}">
            <MenuItem DataContext="{Binding NewProject}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding OpenProject}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding SaveProject}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding ExportProject}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem DataContext="{Binding Exit}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <MenuItem Header="{x:Static loc:Strings.Menu_Edit}">
            <MenuItem DataContext="{Binding Undo}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding Redo}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <MenuItem Header="{x:Static loc:Strings.Menu_Tools}">
            <MenuItem DataContext="{Binding Settings}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <MenuItem Header="{x:Static loc:Strings.Menu_Help}">
            <MenuItem DataContext="{Binding Help}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding Repository}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding Releases}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem DataContext="{Binding Contact}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem DataContext="{Binding About}"
                      Command="{Binding Command}"
                      Header="{Binding Header}"
                      InputGestureText="{Binding GestureText}"
                      ToolTip="{Binding ToolTip}">
              <MenuItem.Icon>
                <controls:SvgIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
              </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </Menu>

    <!-- Barre de commandes -->
    <StackPanel Grid.Row="2" Margin="8,4,8,4" Orientation="Horizontal">
      <ItemsControl ItemTemplate="{StaticResource CommandBarButtonTemplate}"
                    ItemsPanel="{StaticResource HorizontalItemsPanel}"
                    ItemsSource="{Binding CommandBarPrimary}"
                    Focusable="False" />
      <Rectangle Width="1"
                 Margin="8,4,12,4"
                 Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
      <ItemsControl ItemTemplate="{StaticResource CommandBarButtonTemplate}"
                    ItemsPanel="{StaticResource HorizontalItemsPanel}"
                    ItemsSource="{Binding CommandBarSecondary}"
                    Focusable="False" />
    </StackPanel>

    <!-- Onglets : accueil, puis un onglet par console -->
    <TabControl Grid.Row="3"
                Margin="8,0,8,0"
                ItemsSource="{Binding Tabs.Items}"
                SelectedItem="{Binding Tabs.SelectedItem, Mode=TwoWay}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <controls:SvgIcon Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate>
          <ContentPresenter Content="{Binding Content}" />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

    <!-- Barre de statut -->
    <Border Grid.Row="4"
            Padding="12,6"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Style="{DynamicResource Text.Secondary}"
                   Text="{Binding Status.Message}"
                   TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1"
                     Width="160"
                     Height="6"
                     Margin="12,0"
                     VerticalAlignment="Center"
                     IsIndeterminate="{Binding Status.IsIndeterminate}"
                     Maximum="100"
                     Minimum="0"
                     Value="{Binding Status.Progress, Mode=OneWay}"
                     Visibility="{Binding Status.IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Style="{DynamicResource Text.Secondary}"
                   Text="{Binding Status.LanguageCode}"
                   ToolTip="{x:Static loc:Strings.StatusBar_LanguageToolTip}" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
