<ui:FluentWindow x:Class="RomTranslator.App.Views.BinaryDiffWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:RomTranslator.Core.Localization;assembly=RomTranslator.Core"
                 Title="{x:Static loc:Strings.Diff_Title}"
                 Width="720"
                 Height="600"
                 MinWidth="560"
                 MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner"
                 KeyDown="OnWindowKeyDown">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{x:Static loc:Strings.Diff_Title}" />

    <TextBlock Grid.Row="1"
               Margin="24,12,24,12"
               Style="{DynamicResource Text.Subheading}"
               Text="{Binding SummaryText}" />

    <Border Grid.Row="2" Margin="24,0,24,12" Style="{DynamicResource Surface.Card}" Padding="0">
      <Grid>
        <DataGrid AutoGenerateColumns="False"
                  Background="Transparent"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  FontFamily="Consolas"
                  IsReadOnly="True"
                  ItemsSource="{Binding Differences}"
                  Visibility="{Binding AreIdentical, Converter={StaticResource InverseBoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTextColumn Width="110" Binding="{Binding OffsetDisplay}" Header="{x:Static loc:Strings.Diff_OffsetColumn}" />
            <DataGridTextColumn Width="90" Binding="{Binding LengthInBytes}" Header="{x:Static loc:Strings.Diff_LengthColumn}" />
            <DataGridTextColumn Width="*" Binding="{Binding OriginalHex}" Header="{x:Static loc:Strings.Diff_OriginalColumn}" />
            <DataGridTextColumn Width="*" Binding="{Binding ModifiedHex}" Header="{x:Static loc:Strings.Diff_ModifiedColumn}" />
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Style="{DynamicResource Text.Secondary}"
                   Text="{x:Static loc:Strings.Diff_Identical}"
                   Visibility="{Binding AreIdentical, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="3"
                Margin="24,0,24,20"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <ui:Button Appearance="Primary"
                 Click="OnCreateIpsPatchClick"
                 Content="{x:Static loc:Strings.Diff_CreateIpsPatch}"
                 IsEnabled="{Binding AreIdentical, Converter={StaticResource InverseBool}}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
