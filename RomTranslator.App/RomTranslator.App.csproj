<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>RomTranslator</AssemblyName>
    <RootNamespace>RomTranslator.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Seules les langues de l'application sont copiées pour les ressources satellites des dépendances. -->
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomTranslator.Core.Abstractions\RomTranslator.Core.Abstractions.csproj" />
    <ProjectReference Include="..\RomTranslator.Core\RomTranslator.Core.csproj" />
    <!-- Composition directe des modules consoles concrets embarqués par l'application (voir MEMOIRE.md,
         Phase 5.7) : App connaît et compose les modules qu'elle embarque, mais aucun module ne référence
         jamais App en retour (le sens interdit initial reste interdit). -->
    <ProjectReference Include="..\RomTranslator.Modules.SegaSaturn\RomTranslator.Modules.SegaSaturn.csproj" />
  </ItemGroup>

</Project>
