<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil de publication portable : dossier autonome, sans installeur.
  Utilisation : dotnet publish RomTranslator.App -p:PublishProfile=Portable
  Résultat : publish/RomTranslator/ (à copier tel quel, à décompresser n'importe où).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Pas de fichier unique : l'extraction des bibliothèques natives écrirait hors du dossier de l'application. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>..\publish\RomTranslator\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
