<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RomTranslator.Modules.SegaSaturn</RootNamespace>
    <!-- WPF est une brique du framework .NET Windows Desktop, pas une référence à RomTranslator.App :
         un module console fournit sa propre interface (vues XAML) via IConsoleModule.CreateTabContent. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WPF-UI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomTranslator.Core.Abstractions\RomTranslator.Core.Abstractions.csproj" />
    <ProjectReference Include="..\RomTranslator.Core\RomTranslator.Core.csproj" />
  </ItemGroup>

  <!-- Tables de caractères prédéfinies (.tbl) : copiées telles quelles, portables et éditables par l'utilisateur. -->
  <ItemGroup>
    <None Include="CharacterTables\PredefinedTables\*.tbl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PredefinedTables\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
